# .gitignore — finterm (Qt6 / C++20)
# ============================================================

# ── CMake build output ───────────────────────────────────────
app/build/
app/build-*/
app/build_*/
app/tmpqt/
tmpqt/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_deps/

# ── Compiled binaries & libraries ───────────────────────────
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk
*.exp
*.pyd

# ── Qt generated files ───────────────────────────────────────
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm

# ── Python artifacts ─────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
.pdm-python
.pdm-build

# ── setup.sh runtime directories ─────────────────────────────
.qt/
.aqt-venv/

# ── IDE and editor ───────────────────────────────────────────
.idea/
.vscode/
*.suo
*.user
*.sln.docstates
*.ntvs*
*.njsproj
*.sw?
.DS_Store
Thumbs.db
agents.md

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Database files (runtime, not source) ─────────────────────
*.db
*.db-shm
*.db-wal

# ── Environment & secrets — NEVER commit ─────────────────────
.env
.env.local
.env.*.local
*.key
*.pub
*.pem
*.conf
# Personal app data that must stay on this machine: workspaces, crash
# dumps, agent run logs, and ad-hoc session notes.
*.fwsp
crashdumps/
*.dmp
session.txt
.claude/*.lock
# Runtime socket/marker files (base64 names ending in "=") anywhere in the tree.
*=

# ── Large data / ML model files ──────────────────────────────
*.csv
*.bin
*.pt
*.onnx
*.h5
*.pkl
*.pickle
*.model
*.weights

# ── Archives ─────────────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ── Legacy / non-C++ build artifacts (defensive ignores) ─────
**/target/
*.rlib
*.rmeta
node_modules/
dist-ssr/

# ── Claude Code — never commit ───────────────────────────────
.claude/settings.local.json
.claude/worktrees/
CLAUDE.md
app/DESIGN_SYSTEM.md

# ── Build output (uitest) ─────────────────────────────────────
app/uitest/build/

# ── ML training artifacts ─────────────────────────────────────
lightning_logs/
*.ckpt
*.yaml
# Eval fixtures are version-controlled YAML — exempt the harness tree.
!app/scripts/agents/evals/**/*.yaml

# ── Shell tree output files ───────────────────────────────────
**/tree

# ── Duplicate nested agents folder ───────────────────────────
app/scripts/agents/agents/

# ── Firecrawl research artifacts ─────────────────────────────
.firecrawl/

# ── Clangd cache ─────────────────────────────────────────────
.cache/
app/.cache/

# ── Exchange runtime cache ────────────────────────────────────
app/scripts/exchange/.cache/

# ── Python test + bench caches ────────────────────────────────
.pytest_cache/
.benchmarks/

# ── Editor/refactor backups ───────────────────────────────────
*.bak
*.orig
*.deleted
*.deleted.*

# ── Local SQLite databases ────────────────────────────────────
# (*.db is already covered above; adding sqlite variants)
*.sqlite
*.sqlite3

# ── Internal planning docs ────────────────────────────────────
app/docs/superpowers/
docs/superpowers/

# ── Stray runtime artifact ────────────────────────────────────
# Base64-hash filename the running app drops in CWD on launch —
# looks like an SSL/credential marker side effect. Empty file,
# harmless. Ignored at repo root only.
/b_*=
